---
/**
 * HeroSection — 100svhのヒーローエリア。Canvas蒸気パーティクル背景 + タイトル + タグライン
 */
---

<section class="hero">
  <canvas id="hero-canvas" class="hero-canvas" aria-hidden="true"></canvas>
  <div class="hero-content">
    <h1 class="hero-title">KURO COFFEE</h1>
    <p class="hero-tagline">一杯の、深い時間。</p>
  </div>
  <div class="scroll-arrow" aria-hidden="true">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
      <path d="M12 5v14M5 12l7 7 7-7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </div>
</section>

<script>
  import { initSteamParticles } from '../../utils/canvas';
  import { initGSAP, splitTextAnimation, fadeInUp, killAllScrollTriggers } from '../../utils/animation';

  /** HeroセクションのCanvasパーティクルとGSAPアニメーションを初期化する */
  function initHero(): void {
    const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement;
    if (!canvas) return;

    const controller = initSteamParticles(canvas);
    controller.start();

    document.addEventListener('astro:before-swap', () => {
      controller.stop();
      killAllScrollTriggers();
    }, { once: true });

    initGSAP();
    splitTextAnimation('.hero-title');
    fadeInUp('.hero-tagline', { delay: 0.8 });
  }

  initHero();
  document.addEventListener('astro:after-swap', initHero);
</script>

<style>
  .hero {
    position: relative;
    height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .hero-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    text-align: center;
    padding: var(--space-md);
  }

  .hero-title {
    font-family: var(--font-heading);
    font-size: var(--font-size-hero);
    color: var(--color-accent);
    letter-spacing: 0.1em;
    line-height: 1.1;
  }

  .hero-tagline {
    margin-top: var(--space-sm);
    font-size: var(--font-size-xl);
    color: var(--color-text-sub);
    letter-spacing: 0.15em;
  }

  .scroll-arrow {
    position: absolute;
    bottom: var(--space-md);
    left: 50%;
    transform: translateX(-50%);
    color: var(--color-text-sub);
    z-index: 1;
    animation: float 2s ease-in-out infinite;
  }

  @keyframes float {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50% { transform: translateX(-50%) translateY(10px); }
  }
</style>
