---
/**
 * Footer — ナビゲーション・ソーシャルリンク・コピーライトを含むサイトフッター
 */
import { navLinks } from '../../data/navigation';
---

<footer class="footer">
  <div class="footer-inner">
    <nav class="footer-nav" aria-label="フッターナビゲーション">
      <ul class="footer-nav-list">
        {navLinks.map((link) => (
          <li>
            <a href={link.href} class="footer-link">{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="footer-social">
      <a href="https://instagram.com" class="social-link" aria-label="Instagram" target="_blank" rel="noopener noreferrer">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <rect x="2" y="2" width="20" height="20" rx="5" stroke="currentColor" stroke-width="1.5"/>
          <circle cx="12" cy="12" r="5" stroke="currentColor" stroke-width="1.5"/>
          <circle cx="17.5" cy="6.5" r="1.5" fill="currentColor"/>
        </svg>
      </a>
      <a href="https://twitter.com" class="social-link" aria-label="X（旧Twitter）" target="_blank" rel="noopener noreferrer">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M4 4l6.5 8L4 20h2l5.5-6.8L16 20h4l-6.8-8.5L19.5 4h-2l-5 6.2L8 4H4z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>

    <p class="footer-copy">
      <small>&copy; {new Date().getFullYear()} KURO COFFEE. All rights reserved.</small>
    </p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-border);
    padding: var(--space-lg) var(--space-md);
    background: var(--color-bg);
  }

  .footer-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
  }

  .footer-nav-list {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
    justify-content: center;
  }

  .footer-link {
    font-size: var(--font-size-sm);
    color: var(--color-text-sub);
    letter-spacing: 0.05em;
    transition: color var(--transition-fast);
  }

  .footer-link:hover {
    color: var(--color-accent);
  }

  .footer-social {
    display: flex;
    gap: var(--space-sm);
  }

  .social-link {
    color: var(--color-text-sub);
    transition: color var(--transition-fast);
  }

  .social-link:hover {
    color: var(--color-accent);
  }

  .footer-copy {
    color: var(--color-text-sub);
    font-size: var(--font-size-sm);
  }
</style>
