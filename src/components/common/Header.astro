---
/**
 * Header — ロゴ・ナビゲーション・ハンバーガーメニューを含むサイトヘッダー
 */
import { getLangFromUrl, useTranslations, localizedPath, languages } from '../../i18n/ui';
import { getNavLinks } from '../../data/navigation';

const currentPath = Astro.url.pathname;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
/** 現在ロケール向けのナビゲーションリンク */
const links = getNavLinks(lang);
/** 切り替え先のロケールとそのホームURL */
const otherLang = lang === 'ja' ? 'en' : 'ja';
const otherHome = localizedPath('/', otherLang);
---

<header class="header" id="site-header">
  <div class="header-inner">
    <a class="logo" href={localizedPath('/', lang)}>KURO COFFEE</a>

    <nav class="nav-desktop" aria-label="メインナビゲーション">
      <ul class="nav-list">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              class="nav-link"
              aria-current={currentPath === link.href || currentPath === link.href + '/' ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
        <li>
          <a href={otherHome} class="nav-link lang-switch" lang={otherLang} aria-label={t('lang.switch')}>
            {otherLang === 'en' ? 'EN' : 'JA'}
          </a>
        </li>
        <li>
          <button type="button" class="theme-toggle" aria-label={t('theme.toggle')} aria-pressed="false">
            <svg class="theme-icon theme-icon-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.5" />
              <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
            </svg>
            <svg class="theme-icon theme-icon-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
            </svg>
          </button>
        </li>
      </ul>
    </nav>

    <button
      class="hamburger"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="メニューを開く"
    >
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
    </button>
  </div>

  <nav class="nav-mobile" id="mobile-menu" aria-label="メインナビゲーション" hidden>
    <ul class="mobile-nav-list">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class="mobile-nav-link"
            aria-current={currentPath === link.href || currentPath === link.href + '/' ? 'page' : undefined}
          >
            {link.label}
          </a>
        </li>
      ))}
      <li>
        <a href={otherHome} class="mobile-nav-link" lang={otherLang} aria-label={t('lang.switch')}>
          {languages[otherLang]}
        </a>
      </li>
      <li>
        <button type="button" class="theme-toggle theme-toggle-mobile" aria-label={t('theme.toggle')} aria-pressed="false">
          <svg class="theme-icon theme-icon-sun" width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.5" />
            <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          </svg>
          <svg class="theme-icon theme-icon-moon" width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
          </svg>
        </button>
      </li>
    </ul>
  </nav>
</header>

<script>
  import { trapFocus, releaseFocus } from '../../utils/a11y';

  /** 前回のクリーンアップ関数を保持する */
  let cleanupHeader: (() => void) | null = null;

  /** ヘッダーのハンバーガーメニューとスクロール動作を初期化する */
  function initHeader(): void {
    if (cleanupHeader) cleanupHeader();

    const header = document.getElementById('site-header');
    const hamburger = header?.querySelector<HTMLButtonElement>('.hamburger');
    const mobileMenu = document.getElementById('mobile-menu');

    if (!header || !hamburger || !mobileMenu) return;

    /** メニューを開く */
    function openMenu(): void {
      hamburger!.setAttribute('aria-expanded', 'true');
      hamburger!.setAttribute('aria-label', 'メニューを閉じる');
      mobileMenu!.hidden = false;
      trapFocus(mobileMenu!);
    }

    /** メニューを閉じる */
    function closeMenu(): void {
      hamburger!.setAttribute('aria-expanded', 'false');
      hamburger!.setAttribute('aria-label', 'メニューを開く');
      mobileMenu!.hidden = true;
      releaseFocus();
      hamburger!.focus();
    }

    hamburger.addEventListener('click', () => {
      const isOpen = hamburger.getAttribute('aria-expanded') === 'true';
      if (isOpen) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    /** Escapeキーでメニューを閉じる */
    const onKeyDown = (e: KeyboardEvent): void => {
      if (e.key === 'Escape' && hamburger.getAttribute('aria-expanded') === 'true') {
        closeMenu();
      }
    };
    document.addEventListener('keydown', onKeyDown);

    /** スクロール時にヘッダーにblur効果を追加する */
    let ticking = false;
    const onScroll = (): void => {
      if (!ticking) {
        requestAnimationFrame(() => {
          if (window.scrollY > 50) {
            header.classList.add('scrolled');
          } else {
            header.classList.remove('scrolled');
          }
          ticking = false;
        });
        ticking = true;
      }
    };
    window.addEventListener('scroll', onScroll);

    /** テーマ切替ボタンの現在状態を aria-pressed に反映する */
    const syncToggles = (): void => {
      const isLight = document.documentElement.getAttribute('data-theme') === 'light';
      header.querySelectorAll<HTMLButtonElement>('.theme-toggle').forEach((btn) => {
        btn.setAttribute('aria-pressed', String(isLight));
      });
    };

    /** テーマを切り替えて localStorage に保存する */
    const toggleTheme = (): void => {
      const next = document.documentElement.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', next);
      try {
        localStorage.setItem('theme', next);
      } catch (e) {
        /* localStorage が使えない環境では保存をスキップ */
      }
      const meta = document.querySelector('meta[name="theme-color"]');
      if (meta) meta.setAttribute('content', next === 'light' ? '#f6f1e8' : '#1a1a1a');
      syncToggles();
    };

    const themeButtons = header.querySelectorAll<HTMLButtonElement>('.theme-toggle');
    themeButtons.forEach((btn) => btn.addEventListener('click', toggleTheme));
    syncToggles();

    /** リスナーを解除するクリーンアップ関数 */
    cleanupHeader = () => {
      document.removeEventListener('keydown', onKeyDown);
      window.removeEventListener('scroll', onScroll);
      themeButtons.forEach((btn) => btn.removeEventListener('click', toggleTheme));
      cleanupHeader = null;
    };
  }

  initHeader();
  document.addEventListener('astro:after-swap', initHeader);
</script>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: var(--header-height);
    z-index: 100;
    transition: background var(--transition-normal), backdrop-filter var(--transition-normal);
  }

  .header.scrolled {
    background: var(--color-bg-alpha);
    backdrop-filter: blur(10px);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--space-md);
    height: 100%;
  }

  .logo {
    font-family: var(--font-heading);
    font-size: var(--font-size-xl);
    color: var(--color-accent);
    letter-spacing: 0.05em;
  }

  .nav-desktop {
    display: none;
  }

  .nav-list {
    display: flex;
    gap: var(--space-md);
  }

  .nav-link {
    font-size: var(--font-size-sm);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text);
    transition: color var(--transition-fast);
    position: relative;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 1px;
    background: var(--color-accent);
    transition: width var(--transition-normal);
  }

  .nav-link:hover::after,
  .nav-link[aria-current="page"]::after {
    width: 100%;
  }

  .nav-link[aria-current="page"] {
    color: var(--color-accent);
  }

  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    padding: var(--space-xs);
    margin: calc(var(--space-xs) * -1);
    color: var(--color-text);
    cursor: pointer;
    line-height: 0;
    transition: color var(--transition-fast);
  }

  .theme-toggle:hover {
    color: var(--color-accent);
  }

  .theme-icon {
    display: block;
  }

  /* ライト時は月、ダーク時は太陽アイコンを表示 */
  .theme-icon-moon {
    display: none;
  }

  :root[data-theme='light'] .theme-icon-sun {
    display: none;
  }

  :root[data-theme='light'] .theme-icon-moon {
    display: block;
  }

  .hamburger {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: calc(var(--space-xs) * 0.625);
    background: none;
    border: none;
    cursor: pointer;
    padding: var(--space-xs);
    z-index: 101;
  }

  .hamburger-line {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--color-text);
    transition: transform var(--transition-normal), opacity var(--transition-normal);
  }

  .hamburger[aria-expanded="true"] .hamburger-line:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .hamburger[aria-expanded="true"] .hamburger-line:nth-child(2) {
    opacity: 0;
  }

  .hamburger[aria-expanded="true"] .hamburger-line:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .nav-mobile {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100dvh;
    background: var(--color-overlay);
    backdrop-filter: blur(20px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 99;
  }

  .nav-mobile[hidden] {
    display: none;
  }

  .mobile-nav-list {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-lg);
  }

  .mobile-nav-link {
    font-family: var(--font-heading);
    font-size: var(--font-size-2xl);
    color: var(--color-text);
    letter-spacing: 0.1em;
    transition: color var(--transition-fast);
  }

  .mobile-nav-link:hover,
  .mobile-nav-link[aria-current="page"] {
    color: var(--color-accent);
  }

  .theme-toggle-mobile {
    padding: var(--space-xs);
    margin: 0;
    color: var(--color-text);
  }

  @media (min-width: 769px) {
    .nav-desktop {
      display: block;
    }

    .hamburger {
      display: none;
    }

    .nav-mobile {
      display: none;
    }
  }
</style>
