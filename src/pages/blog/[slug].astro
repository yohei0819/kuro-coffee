---
/**
 * ブログ記事詳細ページ — 各ジャーナル記事を表示
 */
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/common/Button.astro';
import { getCollection, render } from 'astro:content';
import { getBasePath } from '../../utils/path';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts
    .filter((post) => post.data.lang === 'ja')
    .map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

/** 日付を「2026年5月20日」形式に整形する */
function formatDate(date: Date): string {
  return date.toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' });
}

/** 記事の構造化データ（schema.org BlogPosting） */
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  author: { '@type': 'Person', name: post.data.author },
  publisher: { '@type': 'Organization', name: 'KURO COFFEE' },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
};
---

<Layout title={post.data.title} description={post.data.description}>
  <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
  <article class="article">
    <div class="article-inner">
      <header class="article-header">
        <p class="article-meta">
          <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
          <span class="article-category">{post.data.category}</span>
        </p>
        <h1 class="article-title">{post.data.title}</h1>
        <p class="article-author">{post.data.author}</p>
      </header>

      <div class="article-body">
        <Content />
      </div>

      <div class="article-action">
        <Button variant="outline" size="md" href={getBasePath('/blog')}>
          ← 記事一覧に戻る
        </Button>
      </div>
    </div>
  </article>
</Layout>

<script>
  import { initGSAP, fadeInUp } from '../../utils/animation';

  /** 記事詳細のGSAPアニメーションを初期化する */
  function initArticle(): void {
    if (!document.querySelector('.article-header')) return;
    initGSAP();
    fadeInUp('.article-header');
  }

  initArticle();
  document.addEventListener('astro:after-swap', initArticle);
</script>

<style>
  .article {
    padding: calc(var(--header-height) + var(--space-lg)) var(--space-md) var(--space-section);
  }

  .article-inner {
    max-width: 720px;
    margin: 0 auto;
  }

  .article-header {
    border-bottom: 1px solid var(--color-border);
    padding-bottom: var(--space-md);
    margin-bottom: var(--space-lg);
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-size: var(--font-size-sm);
    color: var(--color-text-sub);
    margin-bottom: var(--space-sm);
  }

  .article-category {
    color: var(--color-accent);
    border: 1px solid var(--color-border);
    border-radius: 2px;
    padding: 0.1rem 0.6rem;
  }

  .article-title {
    font-family: var(--font-heading);
    font-size: var(--font-size-2xl);
    color: var(--color-text);
    line-height: 1.4;
    margin-bottom: var(--space-sm);
  }

  .article-author {
    color: var(--color-text-sub);
    font-size: var(--font-size-sm);
  }

  .article-body {
    color: var(--color-text);
    line-height: 2;
  }

  .article-body :global(h2) {
    font-family: var(--font-heading);
    font-size: var(--font-size-xl);
    color: var(--color-accent);
    margin: var(--space-lg) 0 var(--space-sm);
  }

  .article-body :global(p) {
    margin-bottom: var(--space-md);
  }

  .article-body :global(ul) {
    margin: 0 0 var(--space-md);
    padding-left: var(--space-md);
  }

  .article-body :global(li) {
    margin-bottom: var(--space-xs);
  }

  .article-body :global(strong) {
    color: var(--color-accent-hover);
  }

  .article-action {
    margin-top: var(--space-xl);
  }
</style>
