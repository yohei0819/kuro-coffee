---
/**
 * Access (English) — 店舗情報・営業時間・アクセス（英語版）
 */
import Layout from '../../layouts/Layout.astro';
import { localizedPath } from '../../i18n/ui';
import { store } from '../../data/store';

/** OpenStreetMap 埋め込み用のバウンディングボックス */
const delta = 0.006;
const bbox = [
  store.longitude - delta,
  store.latitude - delta / 2,
  store.longitude + delta,
  store.latitude + delta / 2,
].join('%2C');
const mapSrc = `https://www.openstreetmap.org/export/embed.html?bbox=${bbox}&layer=mapnik&marker=${store.latitude}%2C${store.longitude}`;
const mapLink = `https://www.openstreetmap.org/?mlat=${store.latitude}&mlon=${store.longitude}#map=17/${store.latitude}/${store.longitude}`;

/** 店舗情報（英語） */
const info = {
  name: 'KURO COFFEE Nakameguro',
  address: '1-2-3 Kamimeguro, Meguro-ku, Tokyo 153-0051, Japan',
  hours: [
    { days: 'Mon–Fri', hours: '8:00 – 20:00' },
    { days: 'Sat, Sun & Holidays', hours: '9:00 – 19:00' },
  ],
  closed: 'Every Wednesday',
  access: [
    '5 min walk from Nakameguro Station (Tokyu Toyoko Line / Tokyo Metro Hibiya Line)',
    'No parking on site. Please use nearby pay parking.',
  ],
};
---

<Layout title="Access" description={`Store information, opening hours and directions for ${info.name}.`}>
  <section class="access-hero">
    <div class="access-hero-inner">
      <h1 class="access-title">Access</h1>
      <p class="access-lead">Store information and opening hours for {info.name}.</p>
    </div>
  </section>

  <section class="access-main">
    <div class="access-inner">
      <div class="access-info">
        <h2 class="access-h2">Store Info</h2>
        <dl class="info-list">
          <div class="info-row">
            <dt class="info-term">Name</dt>
            <dd class="info-desc">{info.name}</dd>
          </div>
          <div class="info-row">
            <dt class="info-term">Address</dt>
            <dd class="info-desc">{info.address}</dd>
          </div>
          <div class="info-row">
            <dt class="info-term">Phone</dt>
            <dd class="info-desc">
              <a href={`tel:${store.tel.replace(/-/g, '')}`} class="info-link">{store.tel}</a>
            </dd>
          </div>
          <div class="info-row">
            <dt class="info-term">Hours</dt>
            <dd class="info-desc">
              <ul class="hours-list">
                {info.hours.map((o) => (
                  <li>{o.days} {o.hours}</li>
                ))}
              </ul>
            </dd>
          </div>
          <div class="info-row">
            <dt class="info-term">Closed</dt>
            <dd class="info-desc">{info.closed}</dd>
          </div>
          <div class="info-row">
            <dt class="info-term">Directions</dt>
            <dd class="info-desc">
              <ul class="access-points">
                {info.access.map((a) => (
                  <li>{a}</li>
                ))}
              </ul>
            </dd>
          </div>
        </dl>

        <p class="access-back">
          <a href={localizedPath('/', 'en')} class="access-link">← Back to home</a>
        </p>
      </div>

      <div class="access-map">
        <h2 class="access-h2">Map</h2>
        <div class="map-frame">
          <iframe
            title={`Map of ${info.name}`}
            src={mapSrc}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
        <a href={mapLink} class="map-external" target="_blank" rel="noopener noreferrer">
          View larger map (OpenStreetMap) →
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { initGSAP, fadeInUp } from '../../utils/animation';

  /** Access（英語）のGSAPアニメーションを初期化する */
  function initAccess(): void {
    if (!document.querySelector('.access-info')) return;
    initGSAP();
    fadeInUp('.access-info');
    fadeInUp('.access-map', { delay: 0.15 });
  }

  initAccess();
  document.addEventListener('astro:after-swap', initAccess);
</script>

<style>
  .access-hero {
    padding: calc(var(--header-height) + var(--space-lg)) var(--space-md) var(--space-lg);
    text-align: center;
  }

  .access-hero-inner {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .access-title {
    font-family: var(--font-heading);
    font-size: var(--font-size-3xl);
    color: var(--color-accent);
    letter-spacing: 0.05em;
    margin-bottom: var(--space-xs);
  }

  .access-lead {
    color: var(--color-text-sub);
    font-size: var(--font-size-lg);
  }

  .access-main {
    padding: 0 var(--space-md) var(--space-section);
  }

  .access-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
    max-width: var(--max-width);
    margin: 0 auto;
    align-items: start;
  }

  .access-h2 {
    font-family: var(--font-heading);
    font-size: var(--font-size-xl);
    color: var(--color-accent);
    margin-bottom: var(--space-md);
  }

  .info-list {
    margin: 0;
  }

  .info-row {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: var(--space-sm);
    padding: var(--space-sm) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .info-term {
    color: var(--color-accent);
    font-size: var(--font-size-sm);
    letter-spacing: 0.05em;
  }

  .info-desc {
    margin: 0;
    color: var(--color-text);
    line-height: 1.8;
  }

  .info-link {
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .info-link:hover {
    color: var(--color-accent);
  }

  .hours-list,
  .access-points {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .access-points li {
    position: relative;
    padding-left: var(--space-sm);
  }

  .access-points li::before {
    content: '・';
    position: absolute;
    left: 0;
    color: var(--color-accent);
  }

  .access-back {
    margin-top: var(--space-md);
  }

  .access-link {
    color: var(--color-accent);
  }

  .access-link:hover {
    color: var(--color-accent-hover);
  }

  .map-frame {
    aspect-ratio: 4 / 3;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    overflow: hidden;
  }

  .map-frame iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
    filter: grayscale(0.3);
  }

  .map-external {
    display: inline-block;
    margin-top: var(--space-sm);
    color: var(--color-accent);
    font-size: var(--font-size-sm);
  }

  .map-external:hover {
    color: var(--color-accent-hover);
  }

  @media (max-width: 768px) {
    .access-inner {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }
  }
</style>
