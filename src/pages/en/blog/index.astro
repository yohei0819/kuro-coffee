---
/**
 * ブログ一覧ページ（英語） — 英語記事の一覧を表示
 */
import Layout from '../../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { localizedPath } from '../../../i18n/ui';
import { getBasePath } from '../../../utils/path';

const posts = (await getCollection('blog'))
  .filter((post) => post.data.lang === 'en')
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

/** 日付を「May 20, 2026」形式に整形する */
function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}

/** 記事スラッグから言語プレフィックスを除いたパスを生成する */
function postPath(id: string): string {
  return localizedPath(`/blog/${id.replace(/^en-/, '')}`, 'en');
}
---

<Layout title="Blog" description="The KURO COFFEE journal — brewing guides, notes on beans, and everyday columns.">
  <section class="blog-hero">
    <div class="blog-hero-inner">
      <h1 class="blog-title">Journal</h1>
      <p class="blog-lead">Brewing guides, notes on beans, and everyday columns.</p>
      <a class="rss-link" href={getBasePath('/en/rss.xml')}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M6.18 15.64a2.18 2.18 0 1 1 0 4.36 2.18 2.18 0 0 1 0-4.36zM4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44zm0 5.66A9.9 9.9 0 0 1 13.9 20h-2.83A7.07 7.07 0 0 0 4 12.93V10.1z" />
        </svg>
        Subscribe via RSS
      </a>
    </div>
  </section>

  <section class="blog-list-section">
    <div class="blog-list-inner">
      <ul class="post-list">
        {posts.map((post) => (
          <li class="post-item">
            <a href={postPath(post.id)} class="post-card">
              <p class="post-meta">
                <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
                <span class="post-category">{post.data.category}</span>
              </p>
              <h2 class="post-card-title">{post.data.title}</h2>
              <p class="post-card-desc">{post.data.description}</p>
              <span class="post-readmore">Read more →</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>

<script>
  import { initGSAP, staggerFadeIn } from '../../../utils/animation';

  /** ブログ一覧（英語）のGSAPアニメーションを初期化する */
  function initBlogList(): void {
    if (!document.querySelector('.post-item')) return;
    initGSAP();
    staggerFadeIn('.post-item', { stagger: 0.12 });
  }

  initBlogList();
  document.addEventListener('astro:after-swap', initBlogList);
</script>

<style>
  .blog-hero {
    padding: calc(var(--header-height) + var(--space-lg)) var(--space-md) var(--space-lg);
    text-align: center;
  }

  .blog-hero-inner {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .blog-title {
    font-family: var(--font-heading);
    font-size: var(--font-size-3xl);
    color: var(--color-accent);
    letter-spacing: 0.05em;
    margin-bottom: var(--space-xs);
  }

  .blog-lead {
    color: var(--color-text-sub);
    font-size: var(--font-size-lg);
  }

  .rss-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    margin-top: var(--space-sm);
    color: var(--color-accent);
    font-size: var(--font-size-sm);
    transition: color var(--transition-fast);
  }

  .rss-link:hover {
    color: var(--color-accent-hover);
  }

  .blog-list-section {
    padding: 0 var(--space-md) var(--space-section);
  }

  .blog-list-inner {
    max-width: 760px;
    margin: 0 auto;
  }

  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .post-card {
    display: block;
    padding: var(--space-md);
    background: var(--color-bg-sub);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    transition: border-color var(--transition-fast), transform var(--transition-fast);
  }

  .post-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
  }

  .post-card:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-ring-offset);
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-size: var(--font-size-sm);
    color: var(--color-text-sub);
    margin-bottom: var(--space-xs);
  }

  .post-category {
    color: var(--color-accent);
    border: 1px solid var(--color-border);
    border-radius: 2px;
    padding: 0.1rem 0.6rem;
  }

  .post-card-title {
    font-family: var(--font-heading);
    font-size: var(--font-size-xl);
    color: var(--color-text);
    margin-bottom: var(--space-xs);
  }

  .post-card-desc {
    color: var(--color-text-sub);
    line-height: 1.8;
    margin-bottom: var(--space-sm);
  }

  .post-readmore {
    color: var(--color-accent);
    font-size: var(--font-size-sm);
  }
</style>
