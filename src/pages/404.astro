---
/**
 * 404ページ — 存在しないURLへのアクセス時に表示するエラーページ
 */
import Layout from '../layouts/Layout.astro';
import Button from '../components/common/Button.astro';
import { getBasePath } from '../utils/path';
---

<Layout title="ページが見つかりません" description="お探しのページは見つかりませんでした。">
  <section class="not-found">
    <div class="not-found-inner">
      <p class="not-found-code">404</p>
      <h1 class="not-found-title">ページが見つかりません</h1>
      <p class="not-found-desc">
        お探しのページは移動または削除された可能性があります。
      </p>
      <div class="not-found-action">
        <Button variant="primary" size="lg" href={getBasePath('/')}>
          ホームに戻る
        </Button>
      </div>
    </div>
  </section>
</Layout>

<style>
  .not-found {
    padding: calc(var(--header-height) + var(--space-xl)) var(--space-md) var(--space-section);
    text-align: center;
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .not-found-inner {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .not-found-code {
    font-family: var(--font-heading);
    font-size: clamp(4rem, 15vw, 10rem);
    color: var(--color-accent);
    line-height: 1;
    opacity: 0.3;
  }

  .not-found-title {
    font-family: var(--font-heading);
    font-size: var(--font-size-2xl);
    color: var(--color-text);
    margin-top: var(--space-sm);
  }

  .not-found-desc {
    color: var(--color-text-sub);
    margin-top: var(--space-sm);
    line-height: 1.8;
  }

  .not-found-action {
    margin-top: var(--space-lg);
  }
</style>
