---
/**
 * Productsページ — 全商品SVGをimportし、ProductFilterに画像URLマップを渡す
 */
import Layout from '../layouts/Layout.astro';
import ProductFilter from '../components/products/ProductFilter';

import kuroBlend from '../assets/products/kuro-blend.svg';
import morningLight from '../assets/products/morning-light.svg';
import tsukiBlend from '../assets/products/tsuki-blend.svg';
import colombiaHuila from '../assets/products/colombia-huila.svg';
import yoruDecaf from '../assets/products/yoru-decaf.svg';
import brazilSantos from '../assets/products/brazil-santos.svg';

const imageMap: Record<string, string> = {
  'kuro-blend.svg': kuroBlend.src,
  'morning-light.svg': morningLight.src,
  'tsuki-blend.svg': tsukiBlend.src,
  'colombia-huila.svg': colombiaHuila.src,
  'yoru-decaf.svg': yoruDecaf.src,
  'brazil-santos.svg': brazilSantos.src,
};
---

<Layout title="Products" description="KURO COFFEEのこだわりのコーヒー豆をご紹介します。">
  <ProductFilter client:visible imageMap={imageMap} />
</Layout>
