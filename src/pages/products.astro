---
/**
 * Productsページ — 全商品WebPをimportし、ProductFilterに画像URLマップを渡す
 */
import Layout from '../layouts/Layout.astro';
import ProductFilter from '../components/products/ProductFilter';

import kuroBlend from '../assets/products/kuro-blend.webp';
import morningLight from '../assets/products/morning-light.webp';
import tsukiBlend from '../assets/products/tsuki-blend.webp';
import colombiaHuila from '../assets/products/colombia-huila.webp';
import yoruDecaf from '../assets/products/yoru-decaf.webp';
import brazilSantos from '../assets/products/brazil-santos.webp';

const imageMap: Record<string, string> = {
  'kuro-blend.webp': kuroBlend.src,
  'morning-light.webp': morningLight.src,
  'tsuki-blend.webp': tsukiBlend.src,
  'colombia-huila.webp': colombiaHuila.src,
  'yoru-decaf.webp': yoruDecaf.src,
  'brazil-santos.webp': brazilSantos.src,
};
---

<Layout title="Products" description="KURO COFFEEのこだわりのコーヒー豆をご紹介します。">
  <ProductFilter client:visible imageMap={imageMap} />
</Layout>
